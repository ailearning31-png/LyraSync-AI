{
  "name": "lyrasync-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fit the Lyrics. Feel the Melody. — adaptasi lirik ke bahasa Indonesia yang nyaman dinyanyikan mengikuti melodi referensi.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
